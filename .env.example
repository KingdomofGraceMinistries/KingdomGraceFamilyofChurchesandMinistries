# Operator credentials for the Supabase CLI. Copy to `.env` and fill in.
# `.env` is gitignored; this example file is not and must stay empty of
# real values.
#
# These are for running MIGRATIONS from a developer machine only. They are
# not application config — the app ships the publishable key inline in
# kg-pastoral-network.html, and the edge functions read their own secrets
# from the Supabase platform, not from this file.
#
# Usage:
#   set -a; . ./.env; set +a
#   npx supabase@latest db push --linked --dry-run
#   npx supabase@latest db push --linked --yes
#
# Personal access token from https://supabase.com/dashboard/account/tokens
# flag is needed and the value never lands in shell history.
# Revoke it from that same page when the work is done.
SUPABASE_ACCESS_TOKEN=

# Only needed if you push by connection string instead of --linked, i.e.
#   npx supabase@latest db push --db-url "postgresql://postgres.<ref>:<pw>@<host>:5432/postgres"
# Percent-encode any reserved characters in the password.
SUPABASE_DB_PASSWORD=

