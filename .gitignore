# Personal/local Claude Code overrides (per-machine, not shared)
.claude/settings.local.json

# Deno
deno.lock

# One-off SQL scratchpads — never commit. PIN values, vault secrets, and
# other operator-only payloads live here. Run them from Supabase SQL
# Editor and either clear the file or leave it; it won't reach git.
supabase/scratch/

# Operator credentials for the Supabase CLI — never commit. Holds the
# personal access token (and/or database password) used to run migrations
# from this machine. Every variant is listed rather than a bare `.env` glob
# so a stray `.env.production` cannot slip through.
.env
.env.*
!.env.example

